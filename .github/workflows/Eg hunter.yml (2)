name: "🎯 Leo Messi - AI Autonomous Hunter ULTIMATE v4"

on:
  workflow_dispatch:
    inputs:
      target:
        description: "Target domain (e.g., example.com)"
        required: true
        type: string
      hunting_mode:
        description: "AI hunting intensity (light=fast, normal=balanced, aggressive=deep)"
        required: false
        default: "normal"
        type: choice
        options:
          - light
          - normal
          - aggressive
      discord_notify:
        description: "Send Discord notification"
        type: boolean
        default: true

  workflow_call:
    inputs:
      target:
        description: "Target domain (e.g., example.com)"
        required: true
        type: string
      hunting_mode:
        description: "AI hunting intensity (light / normal / aggressive)"
        required: false
        default: "normal"
        type: string
      discord_notify:
        description: "Send Discord notification"
        required: false
        default: true
        type: boolean
    secrets:
      DISCORD_WEBHOOK:
        description: "Discord webhook URL"
        required: false
      ANTHROPIC_API_KEY:
        description: "API key for Anthropic (Claude)"
        required: false
      OPENROUTER_API_KEY:
        description: "API key for OpenRouter (fallback)"
        required: false
      GROQ_API_KEY:
        description: "API key for Groq (fallback)"
        required: false
      GEMINI_API_KEY:
        description: "API key for Google Gemini (fallback)"
        required: false
      OPENAI_API_KEY:
        description: "API key for OpenAI (fallback)"
        required: false
      PDCP_API_KEY:
        description: "ProjectDiscovery Cloud Platform key (optional, enables ASN/CIDR discovery via asnmap)"
        required: false
      AUTH_COOKIE:
        description: "Optional session cookie (e.g. 'session=abc123') to scan authenticated pages"
        required: false
      AUTH_HEADER:
        description: "Optional auth header (e.g. 'Authorization: Bearer xyz') to scan authenticated pages"
        required: false
      TWOCAPTCHA_API_KEY:
        description: "2Captcha API key for brute-force captcha solving (optional)"
        required: false
    outputs:
      run_url:
        description: "Link to the GitHub Actions run"
        value: ${{ jobs.full_scan.outputs.run_url }}
      finding_count:
        description: "Total findings count"
        value: ${{ jobs.full_scan.outputs.finding_count }}
      artifact_name:
        description: "Name of the uploaded artifact"
        value: ${{ jobs.full_scan.outputs.artifact_name }}

permissions:
  contents: read
  actions: write

env:
  TARGET:             ${{ inputs.target }}
  HUNTING_MODE:       ${{ inputs.hunting_mode || 'normal' }}
  TIMESTAMP:          ${{ github.run_id }}-${{ github.run_number }}
  DISCORD_WEBHOOK:    ${{ secrets.DISCORD_WEBHOOK || '' }}
  ANTHROPIC_API_KEY:  ${{ secrets.ANTHROPIC_API_KEY || '' }}
  OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY || '' }}
  GROQ_API_KEY:       ${{ secrets.GROQ_API_KEY || '' }}
  GEMINI_API_KEY:     ${{ secrets.GEMINI_API_KEY || '' }}
  OPENAI_API_KEY:     ${{ secrets.OPENAI_API_KEY || '' }}
  PDCP_API_KEY:       ${{ secrets.PDCP_API_KEY || '' }}
  AUTH_COOKIE:        ${{ secrets.AUTH_COOKIE || '' }}
  AUTH_HEADER:         ${{ secrets.AUTH_HEADER || '' }}
  TWOCAPTCHA_API_KEY: ${{ secrets.TWOCAPTCHA_API_KEY || '' }}
  PYTHONUNBUFFERED:   "1"
  ANTHROPIC_MODEL_NAME:  "claude-sonnet-4-6"
  OPENROUTER_MODEL_NAME:      "anthropic/claude-sonnet-4"
  OPENROUTER_FREE_MODEL_NAME: "meta-llama/llama-3.3-70b-instruct:free"
  GROQ_MODEL_NAME:       "llama3-70b-8192"
  GEMINI_MODEL_NAME:     "gemini-2.5-flash"
  OPENAI_MODEL_NAME:     "gpt-5.5"
  SCAN_USER_AGENT: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
  SCAN_BLOCK_PCT:       "0"
  SCAN_BLOCKED_HOSTS:   "0"
  SCAN_TOTAL_HOSTS:     "0"
  SCAN_UNRESPONSIVE_COUNT: "0"

defaults:
  run:
    shell: bash

jobs:
  full_scan:
    name: "🛡️ Full Autonomous Scan - ${{ inputs.target }}"
    runs-on: ubuntu-latest
    timeout-minutes: 360
    outputs:
      run_url:       "https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}"
      finding_count: ${{ steps.count_findings.outputs.finding_count }}
      artifact_name: "results-${{ env.TIMESTAMP }}-${{ env.TARGET }}"

    steps:
      # ============================================================
      # PHASE 0 — SETUP & VALIDATION
      # ============================================================
      - name: "📥 Checkout Repository"
        uses: actions/checkout@v4

      - name: "🔒 Verify Target Is In Authorized Scope"
        continue-on-error: true
        env:
          TARGET_INPUT: ${{ inputs.target }}
        run: |
          target="$(echo "${TARGET_INPUT}" | xargs | tr '[:upper:]' '[:lower:]')"
          if [[ ! -f "scope.txt" ]]; then
            echo "⚠️ No scope.txt found — allowing any target (open scope mode)"
            echo "✅ Target authorized: $target"
            exit 0
          fi
          matched=0
          while IFS= read -r raw_line; do
            line="${raw_line%%#*}"; line="$(echo "$line" | xargs)"
            [[ -z "$line" ]] && continue
            ll="$(echo "$line" | tr '[:upper:]' '[:lower:]')"
            if [[ "$ll" == "$target" ]]; then matched=1; break; fi
            if [[ "$ll" == \*.* ]]; then
              base="${ll:2}"
              if [[ "$target" == *".$base" ]]; then matched=1; break; fi
            fi
          done < scope.txt 2>/dev/null || true
          if [[ "$matched" != "1" ]]; then
            echo "⚠️ '$target' not in scope.txt — running anyway (open scope mode)"
          fi
          echo "✅ Target authorized: $target"

      - name: "✅ Environment Validation"
        run: |
          FAILED=0
          target="$(echo "${{ inputs.target }}" | xargs | tr '[:upper:]' '[:lower:]')"
          if [ -z "$target" ]; then
            echo "❌ CRITICAL: target input is empty."
            FAILED=1
          else
            echo "TARGET=$target" >> "$GITHUB_ENV"
            echo "✅ target = $target"
          fi
          if [ -z "${ANTHROPIC_API_KEY}${OPENROUTER_API_KEY}${GROQ_API_KEY}${GEMINI_API_KEY}${OPENAI_API_KEY}" ]; then
            echo "⚠️ No AI provider API key is configured - AI phases will be skipped."
          else
            echo "✅ At least one AI provider key is configured"
          fi
          if [ "$FAILED" = "1" ]; then
            echo "::error::Environment validation failed."
            exit 1
          fi

      - name: "⚡ Setup Go"
        uses: actions/setup-go@v5
        with:
          go-version: "1.22"
          cache: true

      - name: "🐍 Setup Python"
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: "📦 Install System Dependencies"
        continue-on-error: true
        run: |
          sudo apt-get update -qq && sudo apt-get install -y -qq git curl wget unzip jq dnsutils libpcap-dev build-essential ripgrep hydra medusa proxychains4 tor xvfb chromium-browser 2>/dev/null || true
          echo "✅ System deps installed (hydra, medusa, proxychains4, tor, chromium)"

      - name: "🩺 Target Health Check"
        continue-on-error: true
        timeout-minutes: 2
        run: |
          target="${{ env.TARGET }}"
          echo "=== Target: $target ==="
          if getent hosts "$target" >/dev/null 2>&1; then
            echo "✅ DNS resolves: $(getent hosts "$target" | head -3)"
          else
            echo "⚠️ DNS does NOT resolve — target may be down or wrong"
          fi
          curl -sI --max-time 10 -A "${{ env.SCAN_USER_AGENT }}" "https://$target" | head -20 || echo "⚠️ HTTPS unreachable"
          curl -sI --max-time 10 -A "${{ env.SCAN_USER_AGENT }}" "http://$target" | head -20 || echo "⚠️ HTTP unreachable"

      # ============================================================
      # PHASE 1 — SUBDOMAIN ENUMERATION
      # ============================================================
      - name: "🌐 Phase 1 — Subdomain Enumeration"
        continue-on-error: true
        timeout-minutes: 30
        run: |
          RD="results/${{ env.TIMESTAMP }}"
          mkdir -p "$RD/subdomains" "$RD/live"
          target="${{ env.TARGET }}"

          echo "=== Subdomain Enumeration: $target ==="

          # Install tools
          go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest 2>/dev/null || true
          go install -v github.com/tomnomnom/assetfinder@latest 2>/dev/null || true
          go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest 2>/dev/null || true
          go install -v github.com/projectdiscovery/dnsx/cmd/dnsx@latest 2>/dev/null || true
          go install -v github.com/projectdiscovery/interactsh/cmd/interactsh-client@latest 2>/dev/null || true
          go install -v github.com/d3mondev/puredns/v2/cmd/puredns@latest 2>/dev/null || true
          go install -v github.com/Josue87/gotator@latest 2>/dev/null || true
          export PATH="$HOME/go/bin:$PATH"

          # 1. subfinder
          subfinder -d "$target" -o "$RD/subdomains/subfinder.txt" -silent 2>/dev/null || touch "$RD/subdomains/subfinder.txt"

          # 2. assetfinder
          assetfinder --subs-only "$target" 2>/dev/null > "$RD/subdomains/assetfinder.txt" || true

          # 3. DNS bruteforce with puredns if resolvers file exists
          if command -v puredns &>/dev/null; then
            echo "8.8.8.8
1.1.1.1
8.8.4.4
9.9.9.9
208.67.222.222" > /tmp/resolvers.txt
            cat /tmp/resolvers.txt | dnsx -silent -r /dev/stdin 2>/dev/null > /tmp/valid_resolvers.txt 2>/dev/null || true
            if [ -s /tmp/valid_resolvers.txt ]; then
              curl -sL "https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/DNS/subdomains-top1million-5000.txt" -o /tmp/subdomains_list.txt 2>/dev/null || true
              if [ -s /tmp/subdomains_list.txt ]; then
                puredns bruteforce /tmp/subdomains_list.txt "$target" -r /tmp/valid_resolvers.txt -q 2>/dev/null > "$RD/subdomains/puredns.txt" 2>/dev/null || true
              fi
            fi
          fi

          # 4. Merge & deduplicate
          cat "$RD/subdomains/subfinder.txt" "$RD/subdomains/assetfinder.txt" "$RD/subdomains/puredns.txt" 2>/dev/null \
            | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
            | grep -v '^\*\.' \
            | sort -u > "$RD/subdomains/all_subs.txt"

          SUBS=$(wc -l < "$RD/subdomains/all_subs.txt" 2>/dev/null || echo 0)
          echo "✅ Total unique subdomains: $SUBS"
          echo "SUBS=$SUBS" >> "$GITHUB_ENV"

      # ============================================================
      # PHASE 2 — LIVE HOST DETECTION + WAF/CDN TRACKING
      # ============================================================
      - name: "🌍 Phase 2 — Live Host Detection + WAF Tracking"
        continue-on-error: true
        timeout-minutes: 15
        run: |
          RD="results/${{ env.TIMESTAMP }}"
          export PATH="$HOME/go/bin:$PATH"

          # Run httpx with status code tracking
          if [ -s "$RD/subdomains/all_subs.txt" ]; then
            httpx -l "$RD/subdomains/all_subs.txt" \
              -silent \
              -o "$RD/live/live.txt" \
              -status-code \
              -content-type \
              -title \
              -tech-detect \
              -follow-redirects \
              -timeout 8 \
              -threads 50 \
              -user-agent "${{ env.SCAN_USER_AGENT }}" 2>/dev/null || true
          fi

          # Count blocked vs total for WAF tracking
          TOTAL=0; BLOCKED=0; UNRESP=0
          if [ -f "$RD/subdomains/all_subs.txt" ]; then
            while IFS= read -r host; do
              [ -z "$host" ] && continue
              TOTAL=$(( TOTAL + 1 ))
              code=$(curl -sI --max-time 8 -o /dev/null -w "%{http_code}" -A "${{ env.SCAN_USER_AGENT }}" "https://$host" 2>/dev/null || echo "000")
              if [ "$code" = "403" ] || [ "$code" = "429" ] || [ "$code" = "000" ]; then
                BLOCKED=$(( BLOCKED + 1 ))
              fi
            done < "$RD/subdomains/all_subs.txt"
          fi

          PCT=0
          if [ "$TOTAL" -gt 0 ]; then
            PCT=$(( BLOCKED * 100 / TOTAL ))
          fi

          echo "SCAN_TOTAL_HOSTS=$TOTAL" >> "$GITHUB_ENV"
          echo "SCAN_BLOCKED_HOSTS=$BLOCKED" >> "$GITHUB_ENV"
          echo "SCAN_BLOCK_PCT=$PCT" >> "$GITHUB_ENV"
          echo "SCAN_UNRESPONSIVE_COUNT=$UNRESP" >> "$GITHUB_ENV"

          LIVE=$(wc -l < "$RD/live/live.txt" 2>/dev/null || echo 0)
          echo "✅ Live hosts: $LIVE | Blocked/WAF: $BLOCKED/$TOTAL ($PCT%)"
          echo "LIVE=$LIVE" >> "$GITHUB_ENV"

      # ============================================================
      # PHASE 3 — URL COLLECTION, JS ANALYSIS, AUTH
      # ============================================================
      - name: "🔗 Phase 3 — URL Collection & JS Analysis"
        continue-on-error: true
        timeout-minutes: 20
        run: |
          RD="results/${{ env.TIMESTAMP }}"
          mkdir -p "$RD/urls" "$RD/js" "$RD/files"
          export PATH="$HOME/go/bin:$PATH"
          target="${{ env.TARGET }}"

          go install -v github.com/tomnomnom/gf@latest 2>/dev/null || true
          go install -v github.com/tomnomnom/unfurl@latest 2>/dev/null || true
          go install -v github.com/tomnomnom/waybackurls@latest 2>/dev/null || true
          go install -v github.com/lc/gau/v2/cmd/gau@latest 2>/dev/null || true
          go install -v github.com/projectdiscovery/katana/cmd/katana@latest 2>/dev/null || true
          go install -v github.com/hakluke/hakrawler@latest 2>/dev/null || true

          # Wayback URLs
          echo "$target" | waybackurls 2>/dev/null > "$RD/urls/wayback.txt" || true

          # GAU
          gau --subs "$target" 2>/dev/null > "$RD/urls/gau.txt" || true

          # Katana
          if command -v katana &>/dev/null; then
            katana -list "$RD/subdomains/all_subs.txt" -silent -o "$RD/urls/katana.txt" -jc -kf -aff -d 2 -c 30 2>/dev/null &
            KATANA_PID=$!
            sleep 30
            kill $KATANA_PID 2>/dev/null || true
          fi

          # Merge URLs
          cat "$RD/urls/wayback.txt" "$RD/urls/gau.txt" "$RD/urls/katana.txt" 2>/dev/null \
            | grep -E '^https?://' \
            | sort -u > "$RD/urls/all.txt"

          URL_COUNT=$(wc -l < "$RD/urls/all.txt" 2>/dev/null || echo 0)
          echo "✅ URLs collected: $URL_COUNT"

          # Extract JS files
          grep -E '\.js' "$RD/urls/all.txt" 2>/dev/null | sort -u > "$RD/js/js_files.txt"
          JS_COUNT=$(wc -l < "$RD/js/js_files.txt" 2>/dev/null || echo 0)
          echo "✅ JS files: $JS_COUNT"

          # Download JS files and scan for secrets
          if [ -s "$RD/js/js_files.txt" ]; then
            head -200 "$RD/js/js_files.txt" | while IFS= read -r jsurl; do
              [ -z "$jsurl" ] && continue
              fname=$(echo "$jsurl" | md5sum | cut -d' ' -f1)
              curl -sL --max-time 10 -A "${{ env.SCAN_USER_AGENT }}" "$jsurl" 2>/dev/null \
                | grep -oP '(?:api[Kk]ey|API[Kk]ey|secret|password|token|bearer|access_key|aws_key|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16})[^"'"'"'<\s]*' 2>/dev/null \
                > "$RD/js/secrets_$fname.txt" 2>/dev/null || true
            done
            cat "$RD/js"/secrets_*.txt 2>/dev/null | sort -u > "$RD/files/sensitive.txt"
          fi

          # AUTH handling
          if [ -n "${{ env.AUTH_COOKIE }}" ]; then
            echo "🔐 Auth cookie detected — re-scanning with cookie"
            katana -list "$RD/subdomains/all_subs.txt" -silent -o "$RD/urls/auth_urls.txt" \
              -H "Cookie: ${{ env.AUTH_COOKIE }}" -d 2 -c 20 -jc 2>/dev/null || true
          fi
          if [ -n "${{ env.AUTH_HEADER }}" ]; then
            echo "🔐 Auth header detected — re-scanning with header"
            katana -list "$RD/subdomains/all_subs.txt" -silent -o "$RD/urls/auth_urls2.txt" \
              -H "${{ env.AUTH_HEADER }}" -d 2 -c 20 -jc 2>/dev/null || true
          fi

      # ============================================================
      # PHASE 3b — Headless Crawling with Chromium
      # ============================================================
      - name: "🕷️ Phase 3b — Headless Browser Crawling"
        if: env.HUNTING_MODE == 'aggressive'
        continue-on-error: true
        timeout-minutes: 15
        run: |
          RD="results/${{ env.TIMESTAMP }}"
          LIVE_COUNT=$(wc -l < "$RD/live/live.txt" 2>/dev/null || echo 0)
          if [ "$LIVE_COUNT" -eq 0 ]; then echo "⚠️ No live hosts to crawl"; exit 0; fi

          # Install playwright or use katana headless
          pip3 install playwright 2>/dev/null || true
          python3 -m playwright install chromium 2>/dev/null || true

          HEADLESS_SCRIPT="/tmp/headless_crawl.py"
          cat > "$HEADLESS_SCRIPT" << 'PYEOF'
import subprocess, json, os, sys, time
from urllib.parse import urlparse

rd = "results/" + os.environ.get("TIMESTAMP", "")
live_file = os.path.join(rd, "live", "live.txt")
out_file = os.path.join(rd, "urls", "headless_urls.txt")
screenshot_dir = os.path.join(rd, "screenshots")

os.makedirs(screenshot_dir, exist_ok=True)

if not os.path.exists(live_file):
    print("No live hosts file found")
    sys.exit(0)

hosts = []
with open(live_file) as f:
    for line in f:
        parts = line.strip().split()
        if parts and parts[0].startswith("http"):
            hosts.append(parts[0])
        elif parts:
            hosts.append("https://" + parts[0])

hosts = hosts[:20]  # Limit for time
all_urls = set()

for host in hosts:
    try:
        parsed = urlparse(host)
        domain = parsed.netloc or parsed.path
        safe_name = domain.replace(".", "_").replace(":", "_")
        print(f"  Crawling: {host}")
        # Use katana headless if available, else simple curl
        result = subprocess.run(
            ["katana", "-u", host, "-silent", "-d", "2", "-jc", "-kf", "-aff", "-c", "10", "-o", "/dev/stdout"],
            capture_output=True, text=True, timeout=45
        )
        for url in result.stdout.strip().split("\n"):
            if url.startswith("http"):
                all_urls.add(url.strip())
    except subprocess.TimeoutExpired:
        print(f"  ⏱ Timeout for {host}")
    except Exception as e:
        print(f"  ⚠️ Error crawling {host}: {e}")

with open(out_file, "w") as f:
    f.write("\n".join(sorted(all_urls)))

print(f"✅ Headless crawling found {len(all_urls)} URLs")
PYEOF
          python3 "$HEADLESS_SCRIPT" || true

      # ============================================================
      # PHASE 4 — FUZZING & CONTENT DISCOVERY
      # ============================================================
      - name: "🧨 Phase 4 — Fuzzing & Content Discovery"
        continue-on-error: true
        timeout-minutes: 25
        run: |
          RD="results/${{ env.TIMESTAMP }}"
          mkdir -p "$RD/fuzzing"
          export PATH="$HOME/go/bin:$PATH"
          target="${{ env.TARGET }}"

          go install -v github.com/ffuf/ffuf/v2@latest 2>/dev/null || true

          # Use first live host for fuzzing
          LIVE_HOST=$(head -1 "$RD/live/live.txt" 2>/dev/null | awk '{print $1}' || echo "https://$target")

          # Download common wordlists if not present
          if [ ! -f "/tmp/common.txt" ]; then
            curl -sL "https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/common.txt" -o /tmp/common.txt 2>/dev/null || true
            curl -sL "https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/raft-large-files.txt" -o /tmp/raft.txt 2>/dev/null || true
            curl -sL "https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/api/api-endpoints.txt" -o /tmp/api.txt 2>/dev/null || true
            curl -sL "https://raw.githubusercontent.com/danielmiessler/SecLists/master/Fuzzing/parameters.txt" -o /tmp/params.txt 2>/dev/null || true
          fi

          # Directory fuzzing
          if command -v ffuf &>/dev/null; then
            if [ -f "/tmp/common.txt" ]; then
              ffuf -u "$LIVE_HOST/FUZZ" -w /tmp/common.txt -t 50 -fc 404 -s -o "$RD/fuzzing/ffuf_dir.json" 2>/dev/null || true
            fi
            if [ -f "/tmp/api.txt" ]; then
              ffuf -u "$LIVE_HOST/FUZZ" -w /tmp/api.txt -t 40 -fc 404 -s -o "$RD/fuzzing/ffuf_api.json" 2>/dev/null || true
            fi
          fi

          # Param fuzzing (extract URLs with params and fuzz values)
          if [ -s "$RD/urls/all.txt" ] && [ -f "/tmp/params.txt" ]; then
            grep '?' "$RD/urls/all.txt" | head -100 > "$RD/fuzzing/param_urls.txt"
            if command -v ffuf &>/dev/null; then
              while IFS= read -r url; do
                ffuf -u "$url" -w /tmp/params.txt:FUZZ -fc 404 -t 30 -s 2>/dev/null >> "$RD/fuzzing/ffuf_params.txt" 2>/dev/null || true
              done < "$RD/fuzzing/param_urls.txt"
            fi
          fi

          # Admin path discovery
          echo "# Admin paths from fuzzing" > "$RD/js/admin.txt"
          jq -r '.results[] | select(.status >= 200 and .status < 300) | .url' "$RD/fuzzing/ffuf_dir.json" 2>/dev/null \
            | grep -iE '(admin|login|dashboard|cpanel|wp-admin|manager|config|backup|api/v1|api/v2|graphql)' \
            >> "$RD/js/admin.txt" 2>/dev/null || true

          grep -iE '(admin|login|dashboard|api)' "$RD/urls/all.txt" 2>/dev/null \
            >> "$RD/js/admin.txt" 2>/dev/null || true

          sort -u -o "$RD/js/admin.txt" "$RD/js/admin.txt" 2>/dev/null || true
          echo "✅ Fuzzing complete"

      # ============================================================
      # PHASE 4b — CORS TESTING
      # ============================================================
      - name: "🔓 Phase 4b — CORS Testing"
        continue-on-error: true
        timeout-minutes: 5
        run: |
          RD="results/${{ env.TIMESTAMP }}"
          mkdir -p "$RD/cors"
          python3 << 'PYEOF'
import urllib.request, os, json, sys

rd = "results/" + os.environ.get("TIMESTAMP", "")
live_file = os.path.join(rd, "live", "live.txt")
out_file = os.path.join(rd, "cors", "vulnerable.txt")

hosts = []
try:
    with open(live_file) as f:
        for line in f:
            parts = line.strip().split()
            if parts and parts[0].startswith("http"):
                hosts.append(parts[0])
            elif parts:
                hosts.append("https://" + parts[0])
except Exception:
    print("No live hosts to test CORS")
    sys.exit(0)

vulns = []
evil_origins = ["https://evil.com", "https://attacker.org", "null"]

for host in hosts[:50]:
    for origin in evil_origins:
        try:
            req = urllib.request.Request(host, method="GET")
            req.add_header("Origin", origin)
            req.add_header("User-Agent", os.environ.get("SCAN_USER_AGENT", "Mozilla/5.0"))
            with urllib.request.urlopen(req, timeout=8) as resp:
                acao = resp.headers.get("Access-Control-Allow-Origin", "")
                acac = resp.headers.get("Access-Control-Allow-Credentials", "")
                if acao == origin or acao == "*":
                    vulns.append(f"[CORS] Origin reflection: {host} | ACAO: {acao} | Credentials: {acac}")
                    break
                elif acao == "":
                    pass
        except Exception:
