def call_with_retry(provider, prompt, attempts=3, backoff=3):
    last_err = None
    timeout = 120
    for i in range(attempts):
        try:
            req = urllib.request.Request(provider["url"], data=provider["body_tpl"](prompt), headers=provider["headers"], method="POST")
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.loads(r.read())
        except urllib.error.HTTPError as e:
            try:
                body_preview = e.read(400).decode(errors="ignore")
            except Exception:
                body_preview = ""
            last_err = Exception(f"HTTP {e.code} -> {body_preview[:200]}")
            if i < attempts - 1:
                wait = backoff
                if e.code == 429:
                    try:
                        wait = min(int(e.headers.get("Retry-After", backoff)), 30)
                    except Exception:
                        wait = backoff
                time.sleep(wait)
        except Exception as e:
            last_err = e
            if i < attempts - 1:
                time.sleep(backoff)
    raise last_err

